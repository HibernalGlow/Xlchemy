# Using oldest maintained version for best GLIBC compatibility.
FROM ubuntu:22.04

ARG RUN_TESTS=True

ENV DEBIAN_FRONTEND=noninteractive
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"

COPY ./misc/build_scripts/linux/sources.list /etc/apt/sources.list
RUN apt update && apt install -y \
    git \
    make \
    curl \
    squashfs-tools \
    libfuse2 \
    file \
    p7zip-full \
    xvfb \
    '^libxcb.*-dev' \
    libfontconfig1-dev \
    libfreetype6-dev \
    libx11-dev \
    libx11-xcb-dev \
    libxext-dev \
    libxfixes-dev \
    libglu1-mesa-dev \
    libxrender-dev \
    libxi-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    wget \
    build-essential \
    libreadline-dev \
    libncursesw5-dev \
    libssl-dev \
    libsqlite3-dev \
    tk-dev \
    libgdbm-dev \
    libc6-dev \
    libbz2-dev \
    libffi-dev \
    zlib1g-dev \
    liblzma-dev \
    libdbus-1-3 \
    libpulse-dev \
    libegl1 \
    libpipewire-0.3-0 \
    exiftool \
    xdg-desktop-portal-gtk \
    meson \
    ninja-build \
    nasm \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global http.version HTTP/1.1

# Install Python
RUN curl -fsSL https://pyenv.run | bash
RUN pyenv install 3.13 && \
    pyenv global 3.13

# Copy project files
WORKDIR /build
COPY assets /build/assets
COPY core /build/core
COPY data /build/data
COPY ui /build/ui
COPY bin /build/bin
COPY misc /build/misc
COPY tests /build/tests
COPY LICENSE* main.py requirements* test.py test_convert.py build.py /build/
RUN find /build/ -type d -name "__pycache__" -exec rm -rf {} +

# tests/test_gil_release.py 直接 import xlchemy_rust，所以镜像里必须先有这个扩展，
# 否则测试阶段 INTERNALERROR: No module named 'xlchemy_rust'。
# 只拷清单与 src：本仓没有 .dockerignore，而 rust_bindings/target 是本地 488 MB 构建产物。
# jammy 的 apt rustc 太旧（pyo3 0.22 + slimg-core 需要更新的稳定版），走 rustup minimal。
COPY pyproject.toml /build/pyproject.toml
COPY rust_bindings/Cargo.toml rust_bindings/Cargo.lock /build/rust_bindings/
COPY rust_bindings/src /build/rust_bindings/src
COPY xlchemy_rust/__init__.py /build/xlchemy_rust/
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
# maturin build 不需要激活 venv；造一个 wheel，下面两个环境各自装。
# jammy 自带 dav1d 0.9.x，而 dav1d-sys 要求 >= 1.3.0 —— 让 system-deps 探测失败后
# 自己 clone dav1d 1.5.0 用 meson/ninja/nasm 静态编（SYSTEM_DEPS_*_BUILD_INTERNAL=auto）。
ENV SYSTEM_DEPS_DAV1D_BUILD_INTERNAL=auto
RUN pip install maturin && maturin build --release --out /tmp/whl

# Run unit tests
RUN if [ "${RUN_TESTS}" = "True" ]; then \
        python -m venv /build/env_dev && \
        . /build/env_dev/bin/activate && \
        pip install -r /build/requirements.txt -r /build/requirements_test.txt && \
        pip install /tmp/whl/*.whl && \
        xvfb-run -a python test.py && \
        xvfb-run -a python test_convert.py; \
    fi

# Setup virtual environment
RUN python -m venv /build/env_build && \
    . /build/env_build/bin/activate && \
    pip install -r /build/requirements.txt && \
    pip install /tmp/whl/*.whl

# Setup PyInstaller
RUN cd /build && \
    ./misc/build_scripts/linux/pyinstaller.sh

# Build
RUN mkdir -p /export
RUN . /build/env_build/bin/activate && \
    xvfb-run -a python build.py -b sh -u && \
    cp /build/dist/*.7z /export && \
    mv /build/dist/*.json /export
RUN . /build/env_build/bin/activate && \
    xvfb-run -a python build.py -b appimage-skip-packing && \
    ./misc/appimagetool --appimage-extract && \
    BUILD_NAME=$(cat /build/dist/build_name.txt) && \
    ./squashfs-root/AppRun ./dist/AppDir ./dist/${BUILD_NAME} && \
    cp /build/dist/*.AppImage /export

CMD ["/bin/bash"]
